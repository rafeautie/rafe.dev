{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "rafe-dev",
	"compatibility_date": "2026-01-31",
	"compatibility_flags": ["nodejs_compat"],
	// TanStack Start's handler, plus the Durable Object behind /zombies lobbies
	"main": "./app/server.ts",
	// Served at rafe.dev only.
	"workers_dev": false,
	"preview_urls": false,
	// The /admin GitHub App's client ID, which is public (it is in the sign-in
	// URL). GITHUB_CLIENT_SECRET and SESSION_SECRET are Worker secrets.
	"vars": {
		"GITHUB_CLIENT_ID": "Iv23li0qGHjWnZ9qeBqq"
	},
	// Visits recorded by lib/stats for /admin/stats. No database_id: the first
	// deploy creates the database and later deploys find it by name.
	"d1_databases": [
		{
			"binding": "STATS",
			"database_name": "rafe-dev-stats"
		}
	],
	// Caps how often one address can report visits to /seen, so a script
	// cannot flood the stats. The address is only the counter's key, never
	// stored.
	// One per /zombies lobby, named by its code. It only introduces players
	// for WebRTC; the game runs in the host's browser.
	"durable_objects": {
		"bindings": [{ "name": "ZOMBIES_LOBBY", "class_name": "ZombiesLobby" }]
	},
	"ratelimits": [
		{
			"name": "SEEN_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 120, "period": 60 }
		},
		// Caps how often one address can connect to /zombies lobbies, since
		// each connection can hand out TURN credentials.
		{
			"name": "LOBBY_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 20, "period": 60 }
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	// The TheRaceGame Durable Object was removed with the games feature. v1
	// created the class (still live in production); v2 deletes the class and
	// all of its Durable Objects. A deploy cannot drop a DO class without an
	// explicit delete-class migration. v3 adds the /zombies lobby.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["TheRaceGame"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["TheRaceGame"]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": ["ZombiesLobby"]
		}
	]
}
